model Users {
    id          Int       @id @default(autoincrement())
    user_name   String   @unique @db.VarChar(100)
    first_name  String
    last_name   String?
    email       String  @unique
    dob         DateTime?
    phone       String?   @unique
    country_code String?
    address     String?   @db.Text
    preferences Json      @default("{}")
    password String
    status      Boolean   @default(true)
    created_at  DateTime  @default(now())
    updated_at  DateTime  @default(now())

    todo              Todo[]
    sentTodoShares    SharedTodos[]       @relation("TodoShareSender")
    receiveTodoShares SharedTodos[]       @relation("TodoReceiveSender")
    history           TodoHistoryShared[] @relation("todoHistory")
    userSession       UserSession[] 

    @@map("users")
}
